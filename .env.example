# ===== PostgreSQL (DBMS 1 - data master & transaksi) =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vdi_user
POSTGRES_PASSWORD=vdi_password
POSTGRES_DB=vdi_store
# Opsional: jika diisi, menimpa variabel di atas (mis. Neon/Supabase saat deploy)
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname?sslmode=require

# ===== Redis (DBMS 2 - log aktivitas) =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=vdi_redis_pass
REDIS_DB=0
# Opsional: jika diisi, menimpa variabel di atas (mis. Upstash/Redis Cloud saat deploy)
# REDIS_URL=rediss://default:pass@host:6379
